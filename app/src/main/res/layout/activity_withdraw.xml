<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center">
    <TextView android:text="Withdraw points (1 pt = Rs 1)" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/points" android:hint="Points (min 500)" android:inputType="number" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/upi" android:hint="Your UPI ID" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/submit" android:text="Submit request" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
